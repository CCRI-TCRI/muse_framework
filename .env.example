# Copy this file to .env and fill it in.

# Shown in the header, page titles and on Stripe receipts.
STORE_NAME=Muse Wear

# Password for the /admin area. If you leave it empty a random one is
# printed in the terminal every time the server starts.
ADMIN_PASSWORD=

# Long random string used to sign the admin login cookie.
SESSION_SECRET=

# Stripe keys from https://dashboard.stripe.com/apikeys
# Leave STRIPE_SECRET_KEY empty to run in demo mode (orders are marked paid
# without charging anyone, handy while you set things up).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Three letter currency code Stripe should charge in.
CURRENCY=usd

# The public address of the site, used for Stripe return links.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Optional TURN server for livestreams. Without one, a few viewers on strict
# networks (some offices, some mobile carriers) may not be able to connect.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
