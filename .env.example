# Settings for running the shop on your own computer.
# On Vercel, put these in Project > Settings > Environment Variables instead.

# Shown in the header and page titles.
STORE_NAME=Muhoozi Martin Clothes

# Password for /admin. Required on Vercel. Locally, if you leave it empty,
# a temporary one is printed in the terminal when the server starts.
ADMIN_PASSWORD=

# Optional. A long random string used to sign the admin login cookie.
# If empty, one is worked out from ADMIN_PASSWORD.
SESSION_SECRET=

# Postgres connection. Vercel fills this in when you connect a Neon database.
# Leave empty locally to use the built-in database in the data/ folder.
DATABASE_URL=

# Vercel Blob for photos and films. Vercel fills this in when you connect a
# Blob store. Leave empty locally to save files in the uploads/ folder.
BLOB_READ_WRITE_TOKEN=

# Optional. Your shop's address, e.g. https://shop.example.com
# Normally worked out automatically.
PUBLIC_URL=

PORT=3000

# Optional TURN relay for livestreams, for viewers on very strict networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
